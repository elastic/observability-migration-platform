    "name": "instance",
    "type": "query",
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "query": "label_values(redis_up, instance)",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    }
   }
  ]
 },
