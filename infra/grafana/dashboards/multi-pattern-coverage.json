{
  "id": null,
  "uid": "multi-pattern-coverage",
  "title": "Multi Pattern Coverage",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "tags": [
    "test",
    "multi-pattern"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(http_requests_total, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "payments",
          "value": "payments"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "type": "dashboard",
        "builtIn": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Service Route Rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"2..\"}[5m])) by (service, route)",
          "refId": "A",
          "legendFormat": "{{service}} / {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "axisLabel": "Requests/s"
          }
        }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Queue Depth Bullet",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "avg(queue_depth)",
          "refId": "A",
          "legendFormat": "queue depth"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 500,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 450
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Combined Patterns",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 4,
          "type": "timeseries",
          "title": "Merged Request Streams",
          "gridPos": {
            "x": 0,
            "y": 9,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "targets": [
            {
              "expr": "rate(frontend_requests_total[5m])",
              "refId": "A",
              "legendFormat": "frontend"
            },
            {
              "expr": "rate(worker_jobs_total[5m])",
              "refId": "B",
              "legendFormat": "worker"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops"
            }
          }
        },
        {
          "id": 5,
          "type": "timeseries",
          "title": "Partial Target Drop",
          "gridPos": {
            "x": 12,
            "y": 9,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "targets": [
            {
              "expr": "rate(api_requests_total[5m])",
              "refId": "A",
              "legendFormat": "api"
            },
            {
              "expr": "avg(node_load1)",
              "refId": "B",
              "legendFormat": "load"
            },
            {
              "expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket[5m]))",
              "refId": "C",
              "legendFormat": "p95"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          }
        },
        {
          "id": 6,
          "type": "barchart",
          "title": "Native ESQL Errors",
          "gridPos": {
            "x": 0,
            "y": 17,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "elasticsearch",
            "uid": "elastic-metrics"
          },
          "targets": [
            {
              "refId": "A",
              "query": "FROM metrics-* | WHERE service.name == \"api\" | STATS errors = SUM(http.server.errors) BY time_bucket = BUCKET(@timestamp, 50, ?_tstart, ?_tend), service.name | SORT time_bucket ASC"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          },
          "options": {
            "orientation": "vertical",
            "stacking": "none"
          }
        },
        {
          "id": 7,
          "type": "stat",
          "title": "Namespace Pod Count",
          "gridPos": {
            "x": 12,
            "y": 17,
            "w": 6,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "targets": [
            {
              "expr": "sum(kube_pod_info) by (pod)",
              "refId": "A",
              "legendFormat": "{{pod}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          }
        },
        {
          "id": 8,
          "type": "gauge",
          "title": "SLO Burn Rate",
          "gridPos": {
            "x": 18,
            "y": 17,
            "w": 6,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "targets": [
            {
              "expr": "avg(slo_burn_rate)",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 2
                  },
                  {
                    "color": "red",
                    "value": 5
                  }
                ]
              }
            }
          }
        },
        {
          "id": 9,
          "type": "logs",
          "title": "Service Error Logs",
          "gridPos": {
            "x": 0,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "expr": "{service=\"api\"} |~ \"timeout|error\"",
              "refId": "A"
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": true,
            "wrapLogMessage": true,
            "sortOrder": "Descending"
          }
        },
        {
          "id": 10,
          "type": "text",
          "title": "Coverage Notes",
          "gridPos": {
            "x": 12,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "options": {
            "mode": "markdown",
            "content": "Dashboard-level coverage for multi-targets, controls, native ES|QL, and manual-review paths."
          }
        },
        {
          "id": 11,
          "type": "alertlist",
          "title": "Legacy Alert List",
          "gridPos": {
            "x": 12,
            "y": 33,
            "w": 12,
            "h": 4
          }
        }
      ]
    }
  ]
}
