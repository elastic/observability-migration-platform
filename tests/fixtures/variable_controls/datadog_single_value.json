{
  "title": "Smoke DD Single",
  "id": "smoke-dd-single",
  "description": "",
  "layout_type": "ordered",
  "template_variables": [
    {"name": "host", "prefix": "host", "default": "", "available_values": []}
  ],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "timeseries",
        "title": "DD Panel A",
        "requests": [{"q": "avg:system.load.1{host:$host}"}]
      }
    },
    {
      "id": 2,
      "definition": {
        "type": "timeseries",
        "title": "DD Panel B",
        "requests": [{"q": "avg:system.cpu.user{host:$host}"}]
      }
    }
  ]
}
