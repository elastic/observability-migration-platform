{
  "uid": "gf-fp-ingest-stories",
  "title": "Grafana field-profile ingest stories",
  "description": "Compact stand-in for the four ways people typically scrape Prometheus into Grafana, then land the same signals in Elastic: node_exporter hosts, cAdvisor/kubelet, Redis exporter, and app RED metrics.",
  "schemaVersion": 39,
  "tags": ["test", "field-profile"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prom"},
        "query": "label_values(up, instance)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prom"},
        "query": "label_values(container_memory_usage_bytes, namespace)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prom"},
        "query": "label_values(http_requests_total, job)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage by instance (node_exporter)",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "sum(rate(node_cpu_seconds_total{mode!=\"idle\", instance=~\"$instance\"}[$__rate_interval])) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory by pod (cAdvisor / kubelet)",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{namespace=~\"$namespace\"}) by (namespace, pod)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Redis memory used (redis_exporter)",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "redis_memory_used_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP request rate by job (app RED)",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\"$job\"}[$__rate_interval])) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    }
  ]
}
